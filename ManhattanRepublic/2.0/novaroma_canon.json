{
  "version": "2.0.0",
  "context": {
    "setting": "NOVA ROMA established Roman Republic settlement, ~509 BC",
    "starting_population": 500,
    "language": "Latin",
    "institutions": [
      "Senate",
      "Magistrates",
      "Assemblies",
      "Customs Duties"
    ],
    "tech_constraints": "Late Iron Age / Early Roman Republic",
    "starting_entity_type": "settlement",
    "premise": "Established riverine settlement (~500 people); recently unified under a new leader and beginning cautious outward engagement after long isolation. Culture and language are locally evolved but Latin-like."
  },
  "maps": {
    "UGRID35": "Manhattan-focused 100m grid",
    "milestone_generation": "A request that results in an action or project should generate a milestone under an initiative. Each milestone must include an ID (Y-#), a target date, and an impact description.",
    "METRO": "Borough-scale multi-segment shoreline model",
    "MGRD-300": "300m macro overlay"
  },
  "reporting": {
    "discipline": "Reports are displayed to the user and not saved as files by default.",
    "milestone_id_format": "<year>-<serial> (year = years since initiative start, serial = milestone number within that year; e.g., 1-1, 1-2, 2-1)",
    "milestone_id_rule": "Only milestones receive an ID. Do not use a 'Y' prefix.",
    "date_format": "All milestone and report dates must use the format 'MMM D, YYYY' (e.g., Mar 1, 509 BCE)."
  },
  "milestones_report": {
    "purpose": "Advance time and report milestone progress.",
    "title_format": "Milestones Report (Mon DD–DD, YYYY)",
    "ci_line": "CI: v<canon> | R<before>→R<after> | {REV|MINOR|MAJOR}",
    "sections": [
      "COMPLETED",
      "IN PROGRESS",
      "PLANNED (Grouped by Initiative)",
      "SUMMARY",
      "FOOTER"
    ],
    "completed_columns": [
    ],
    "in_progress_columns": [
      "ID",
      "Initiative",
      "Description",
      "Target Date",
      "Cost",
      "Work-hours",
      "Status"
    ],
    "planned_grouping_rule": "Planned milestones are grouped by their parent Initiative. Each group is presented as a separate table.",
    "planned_columns": [
      "ID",
      "Description",
      "Target Date",
      "Cost",
      "Work-hours",
      "Status"
    ],
    "table_format": "Markdown table format is used for all milestone sections.",
    "footer": [
      "Pop: Δ <value | unknown | est>",
      "GDP: Δ <value | est>"
    ]
  },
  "milestone_insight_report": {
    "purpose": "Explain a decision, its constraints, impact, and risks.",
    "format": "<N>️⃣ <DECISION TITLE>"
  },
  "site_report": {
    "purpose": "Site status and details.",
    "title_format": "<Country> Site Report (MMM D, YYYY)",
    "sections": [
      "North District",
      "Central District",
      "South District",
      "Top 3 Issues/Risks"
    ],
    "table_columns": [
      "Site",
      "Area",
      "Population",
      "Pop GR",
      "GDP GR",
      "GRD",
      "TMH %",
      "Primary Role",
      "Status Notes"
    ],
    "issues_risks_format": [
      "1.",
      "2.",
      "3."
    ]
  },
  "status_report": {
    "purpose": "Answer 'Status X' questions.",
    "format": "Status — <Entity / Site / Group>",
    "sections": [
      "Governance / Authority",
      "Population",
      "Operations",
      "Risks",
      "Summary"
    ]
  },
  "rules": {
    "do_not_invent": [
      "population",
      "GDP",
      "capacity",
      "technology"
    ],
    "unknown_is_valid": true,
    "estimates_label": "est",
    "population_source": "Global Population Table",
    "date_usage": "Use in-campaign dates only for all reports and logs. Do not use real-world dates.",
    "advance_next": "The command 'Next' always advances the campaign by 3 in-campaign days.",
    "next_reporting": "When 'Next' is used, report on any milestones that completed during the timeline advance.",
    "narrative_guardrails": [
      "Trade narration must obey systems.trade.gating_rules (no assumed neighbors or built ships).",
      "Campaign starts as an established settlement with starting population=500 (campaign_default). Treat as established community; avoid 'colonial' framing.",
      "Canon Impact (CI) middle fields must be descriptive phrases, not schema keys."
    ],
    "canon_impact": {
      "format": "CI: v<canon> | R<before>→R<after> | {REV|MINOR|MAJOR}",
      "labeling_rule": "CI middle segment must use human-readable field labels (e.g., 'Starting Population') rather than internal JSON paths.",
      "examples": [
        "CI: v2.7 | RStart Conditions: settlement; RStarting Population: unspecified→500; RNarrative Framing: neutral→outward-focused | MAJOR"
      ],
      "middle_field_style": "Human-readable descriptive labels (e.g., 'Starting Population', 'Narrative Framing'), not JSON paths or internal keys."
    },
    "domain_governance": {
      "target_range": "40–70",
