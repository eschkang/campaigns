{
  "version": "2.8",
  "context": {
    "setting": "NOVA ROMA Roman Republic settlement, ~509 BC",
    "starting_population": 500,
    "language": "Latin",
    "institutions": [
      "Senate",
      "Magistrates",
      "Assemblies",
      "Customs Duties"
    ],
    "tech_constraints": "Late Iron Age / Early Roman Republic",
    "starting_entity_type": "settlement",
    "premise": "Established riverine settlement (~500 people); recently unified under a new leader and beginning cautious outward engagement after long isolation. Culture and language are locally evolved but Latin-like."
  },
  "maps": {
    "UGRID35": "Manhattan-focused 100m grid",
    "milestone_generation": "A request that results in an action or project should generate a milestone under an initiative. Each milestone must include an ID (Y-#), a target date, and an impact description.",
    "METRO": "Borough-scale multi-segment shoreline model",
    "MGRD-300": "300m macro overlay"
  },
  "reporting": {
    "discipline": "Reports are displayed to the user and not saved as files by default.",
    "milestone_id_format": "<year>-<serial> (year = years since initiative start, serial = milestone number within that year; e.g., 1-1, 1-2, 2-1)",
    "milestone_id_rule": "Only milestones receive an ID. Do not use a 'Y' prefix.",
    "date_format": "All milestone and report dates must use the format 'MMM D, YYYY' (e.g., Mar 1, 509 BCE)."
  },
  "milestones_report": {
    "purpose": "Advance time and report milestone progress.",
    "title_format": "Milestones Status Report (Mon DD–DD, YYYY)",
    "ci_line": "CI: v<canon> | Version: <prev_version>→<new_version> | <change_type> – <short_reason>",
    "sections": [
      "News / Events",
      "Completed / Imminent",
      "In Progress",
      "Planned (next 10 milestones)",
      "Completed Audits",
      "Metrics",
      "Advisors"
    ],
    "news_presentation_rule": "News is written in newspaper-style headlines with parenthetical in-game effects.",
    "completed_imminent_columns": [
      "ID",
      "Initiative",
      "Description",
      "Target Date",
      "Cost",
      "Work-hours",
      "Effect/Impact",
      "Status"
    ],
    "in_progress_columns": [
      "ID",
      "Initiative",
      "Description",
      "Target Date",
      "Cost",
      "Manhours",
      "Status"
    ],
    "planned_columns": [
      "ID",
      "Description",
      "Target Date",
      "Cost",
      "Work-hours",
      "Status"
    ],
    "planned_limit": 10,
    "completed_audits_format": "List of completed audits with brief notes.",
    "metrics_columns": [
      "Metric",
      "Δ (delta)",
      "Annualized"
    ],
    "metrics_gdp_row_position": 2,
    "advisors_format": "Each advisor entry must include area of expertise, two sound actions, and one intentionally poor action.",
    "table_format": "Markdown table format is used for all milestone sections."
  },
  "milestone_insight_report": {
    "purpose": "Explain a decision, its constraints, impact, and risks.",
    "format": "<N>️⃣ <DECISION TITLE>"
  },
  "site_report": {
    "purpose": "Site status and details.",
