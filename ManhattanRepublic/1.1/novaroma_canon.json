  "systems": {
    "trade": {
      "purpose": "Prevent overstating trade before contacts, routes, and shipbuilding exist.",
      "definitions": {
        "proto_trade": "Incidental barter with transient/unidentified parties. No mapped partners, no formal routes, no treaties.",
        "contacted_partner": "A partner confirmed via a completed contact/diplomacy milestone and recorded in state.",
        "trade_route": "A recurring exchange with origin/destination/cargo recorded in state and enabled by a completed route charter milestone."
      },
      "gating_rules": [
        "Do not describe organized external trade (exports/imports with named partners or routes) unless at least one contacted_partner exists.",
        "Do not describe ship-based commerce beyond skiffs/fishing craft unless a shipbuilding milestone (yard/slipway/hull completion) is COMPLETED.",
        "Before contacts exist, STATUS trade must use proto_trade language only.",
        "Customs duties may exist internally, but do not imply high volumes or stable merchant queues before routes and infrastructure milestones."
      ],
      "status_report_guidance": {
        "trade_status_phrasing": {
          "before_contact": "Trade is embryonic and opportunistic (proto-trade). Occasional passing craft may barter at the shoreline; no mapped partners, routes, or treaties exist.",
          "after_contact_before_routes": "Trade is emerging with known partners but remains ad hoc; no chartered routes yet.",
          "after_routes": "Trade is active with chartered routes; throughput depends on infrastructure and preservation."
        }
      }
    }
  },
